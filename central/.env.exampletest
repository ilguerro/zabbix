# ==============================================================================
# Central Zabbix Server Configuration (4GB RAM)
# ==============================================================================
# Reference sizing for a 4GB VM (small lab/test, ~200-500 hosts). Adjust per
# section below.
# IMPORTANT: change all passwords before going to production!
# To generate secure passwords: openssl rand -base64 32

# Docker image tag deployed for all Zabbix containers. Pin an LTS tag for
# reproducible upgrades; "trunk" tracks the development branch and can break.
# Applied on the next "docker compose up -d".
#ZABBIX_VERSION=alpine-7.4.14
ZABBIX_VERSION=alpine-trunk # 8.0

# Timezone for all containers: log timestamps, PHP/frontend defaults.
TZ=Europe/Rome

# Label shown in the frontend title bar only. No functional effect.
ZBX_SERVER_NAME=Zabbix Central

# PostgreSQL database and account created on FIRST initialization of the DB
# volume, then reused by the server, web and backup containers.
# NOTE: POSTGRES_PASSWORD is only applied by Postgres on first init - to
# rotate it later, ALTER the user inside Postgres and update it here.
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=password # Generate using `openssl rand -hex 16`

# ==============================================================================
# Caddy / Reverse Proxy (HTTPS termination, ports 80/443)
# ==============================================================================

# Public FQDN the frontend is served on. Needs an A/AAAA DNS record
# pointing here; Caddy obtains and auto-renews a Let's Encrypt certificate
# for it on first start. Changing it means a new certificate is issued.
ZBX_FQDN=zabbix.acme.tld

# Email registered with Let's Encrypt - receives expiry/failure alerts.
# Renewal itself is automatic; this is only for notifications.
ACME_EMAIL=email@acme.tld

# Cloudflare credentials for the DNS-01 challenge: Caddy proves domain
# control by creating a TXT record, so issuance works without exposing
# port 80. The token needs Zone:DNS:Edit on this zone; if invalid,
# certificate issuance fails at startup.
CLOUDFLARE_EMAIL=email@acme.tld
CLOUDFLARE_API_TOKEN=token # Get one from cloudflare.com

# ==============================================================================
# PostgreSQL Tuning (sized for 4GB RAM - scale to your VM)
# ==============================================================================

# Shared memory (/dev/shm) given to the DB container. Used by PostgreSQL's
# parallel query workers: too small and parallel queries abort with
# shared-memory errors; larger brings no further benefit.
PG_SHM_SIZE=256m

# Hard cap on simultaneous DB connections (server, frontend, backups).
# Each connection is a backend process (~5-10MB RAM). Raise it and you
# spend RAM; hit the cap and new connections are rejected outright.
PG_MAX_CONNECTIONS=100

# RAM PostgreSQL dedicates to caching hot table/index pages - its own
# cache, separate from the OS page cache. Larger = more reads served from
# memory and less disk I/O; past ~25-30% of RAM gains flatten and other
# containers start competing for memory.
PG_SHARED_BUFFERS=1GB

# Allocates NOTHING: it only tells the query planner how much total cache
# (shared_buffers + OS cache) to assume is available. Higher = the planner
# assumes data is in memory and prefers index scans; lower = it assumes
# disk access and prefers sequential scans, possibly skipping good indexes.
PG_EFFECTIVE_CACHE_SIZE=2GB

# RAM granted to EACH sort/hash/aggregation step of EACH query before it
# spills to disk (slow). Raising it speeds heavy history queries, but the
# usage multiplies by concurrent operations - too high risks the OOM
# killer under load.
PG_WORK_MEM=8MB

# Like work_mem but for maintenance jobs (VACUUM, CREATE INDEX, ALTER
# TABLE). Only a few such operations run at once, so it can safely be much
# larger than work_mem. Higher = faster vacuuming and index builds.
PG_MAINTENANCE_WORK_MEM=256MB

# How expensive the planner thinks a random disk read is, relative to a
# sequential one. Low (1.1) = trusts indexes aggressively - right for
# SSD/NVMe. High (4.0) = avoids indexes - only right for spinning HDDs.
# A wrong value makes Postgres pick slow query plans.
PG_RANDOM_PAGE_COST=1.1

# How many I/O requests PostgreSQL keeps in flight for prefetching
# (bitmap scans, VACUUM, index builds). High values suit SSD/NVMe; on an
# HDD a high value causes seek thrashing and slows everything down.
PG_EFFECTIVE_IO_CONCURRENCY=200

# RAM buffer for write-ahead log records before they are flushed to disk.
# 16MB is the practical maximum (Postgres's own auto-tuning caps here) -
# raising it further does nothing.
PG_WAL_BUFFERS=16MB

# Soft limit on write-ahead log kept between checkpoints. Larger =
# checkpoints happen less often, write I/O is smoother and throughput
# better, but crash recovery replays more WAL and uses more disk.
PG_MAX_WAL_SIZE=2GB

# Floor for WAL disk usage: WAL files are recycled down to this size
# instead of being deleted and recreated, avoiding allocation churn.
# Raising it just reserves more disk for WAL permanently.
PG_MIN_WAL_SIZE=512MB

# Maximum time between automatic WAL checkpoints. Longer = fewer, larger
# checkpoint write bursts and better write throughput, in exchange for
# more WAL on disk and longer crash recovery.
PG_CHECKPOINT_TIMEOUT=15min

# Spreads each checkpoint's writes over this fraction of the interval
# above instead of one burst. 0.9 = writes are spread across 90% of the
# window for smooth I/O; lower values concentrate the I/O into a spike.
PG_CHECKPOINT_COMPLETION_TARGET=0.9

# ==============================================================================
# Zabbix Server - Processes & Caches
# ==============================================================================
# Rule of thumb for process counts: raise a count when the frontend's
# "Data collection" graphs show that process type near 100% utilization or
# the monitoring queue grows. Unused processes just idle in RAM.

# Seconds to wait for agent/SNMP/external checks before declaring the item
# failed. Higher tolerates slow devices but each slow check occupies its
# poller longer, delaying everything queued behind it.
ZBX_TIMEOUT=5

# Poller processes for active checks (Zabbix agent, SNMP, IPMI...).
# More pollers = more checks per interval; too few = delayed items and a
# growing monitoring queue.
ZBX_STARTPOLLERS=5

# Extra pollers reserved for unreachable hosts, so their retries don't
# steal capacity from healthy hosts. More = faster recheck rate while
# sites are down.
ZBX_STARTPOLLERSUNREACHABLE=2

# Processes accepting pushed data (active agents, zabbix_sender, proxies).
# More = absorbs higher concurrent ingest; too few and agents/proxies see
# connection failures or slow ingestion.
ZBX_STARTTRAPPERS=5

# ICMP ping workers; each runs many pings per round. More = more hosts
# pinged per interval or tighter schedules.
ZBX_STARTPINGERS=3

# Workers for network discovery rules - one per rule being scanned.
# More = large ranges finish discovery faster.
ZBX_STARTDISCOVERERS=2

# Workers executing web monitoring scenarios (HTTP steps).
ZBX_STARTHTTPPOLLERS=2

# Cache holding the whole monitoring configuration (hosts, items,
# triggers). It must all fit or the server fails to start; headroom beyond
# the config size is simply unused RAM.
ZBX_CACHESIZE=128M

# Queue of collected values waiting to be written to PostgreSQL. Larger
# absorbs ingest bursts and DB slowdowns; if it fills completely, data
# collection stalls until the DB catches up.
ZBX_HISTORYCACHESIZE=64M

# Index of the history cache above - scales with the number of items, not
# data volume. Keep it roughly a quarter of the history cache.
ZBX_HISTORYINDEXCACHESIZE=16M

# Same buffering role as the history cache, but for hourly trend
# aggregates.
ZBX_TRENDCACHESIZE=32M

# Cache of each item's most recent values, consulted by trigger
# expressions and calculated items. Larger = functions like last()/avg()
# are answered from RAM instead of querying the DB; too small = slow
# trigger evaluation and database read spikes.
ZBX_VALUECACHESIZE=128M

# Pollers for PASSIVE proxies only (where the server connects out to the
# proxy). All proxies in this setup are active (they connect here), so
# keep 0 - non-zero would just spawn idle processes.
ZBX_STARTPROXYPOLLERS=0

# Writer processes flushing the history cache into PostgreSQL in batches.
# More = higher insert throughput; too few = history cache fills up.
# Each writer also consumes one PG_MAX_CONNECTIONS slot.
ZBX_STARTDBSYNCERS=4

# Workers preprocessing incoming values (multipliers, regex, throttling,
# dependent items). Too few = the preprocessing queue grows and values
# reach history/triggers late.
ZBX_STARTPREPROCESSORS=5

# ==============================================================================
# PostgreSQL Backup (prodrigestivill/postgres-backup-local)
# ==============================================================================

# When dumps run, as cron syntax or @daily/@weekly/@monthly aliases.
# Backups land in ./postgres/backups.
BACKUP_SCHEDULE=@daily

# Grandfather-father-son retention: daily dumps kept before the oldest is
# deleted. Larger = more restore points, more disk used.
BACKUP_KEEP_DAYS=5

# Weekly dumps kept before deletion.
BACKUP_KEEP_WEEKS=2

# Monthly dumps kept before deletion.
BACKUP_KEEP_MONTHS=1
