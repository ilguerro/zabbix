# ==============================================================================
# Configurazione Zabbix Proxy - Sede Cliente
# ==============================================================================
# Personalizza questo file per OGNI sede cliente, poi copialo in .env
# Valori di riferimento: sede piccola/media (2 vCPU, 4GB RAM, ~200 host)

# Versione Zabbix - DEVE corrispondere ESATTAMENTE al server centrale
#ZABBIX_VERSION=alpine-7.4.14
ZABBIX_VERSION=alpine-trunk # 8.0

# Timezone del sistema
TZ=Europe/Rome

# ==============================================================================
# Identificazione e collegamento al server centrale
# ==============================================================================

# Hostname del proxy: deve combaciare ESATTAMENTE con il nome configurato
# nel frontend Zabbix in Administration -> Proxies
ZBX_PROXY_HOSTNAME=proxy-acme

# Indirizzo del server Zabbix centrale (FQDN o IP pubblico/VPN).
# Se il server ascolta su una porta diversa: zabbix.acme.tld:10051
ZBX_SERVER_HOST=zabbix.acme.tld

# 0 = active (il proxy si connette al server), 1 = passive
ZBX_PROXYMODE=0

# Indirizzo su cui esporre le porte del proxy sulla LAN della sede.
# 0.0.0.0 espone su tutte le interfacce: usa l'IP della LAN se possibile.
ZBX_LISTEN_ADDR=0.0.0.0

# ==============================================================================
# TLS PSK verso il server centrale
# ==============================================================================

# Identita' PSK (deve corrispondere a quanto configurato nel frontend)
ZBX_TLS_PSK_IDENTITY=PSK-acme

# Valore PSK, 64 caratteri hex. Genera con: openssl rand -hex 32
# Deve corrispondere ESATTAMENTE al valore inserito nel frontend Zabbix.
# UNICO per ogni sede: mai riusare la stessa PSK su piu' proxy.
ZBX_TLS_PSK_VALUE=psk # Generate using `openssl rand -hex 32`

# ==============================================================================
# Sincronizzazione col server
# ==============================================================================

# Timeout massimo (secondi) per agent, SNMP, external checks
ZBX_TIMEOUT=30

# Ogni quanti secondi il proxy riscarica la configurazione dal server
ZBX_PROXYCONFIGFREQUENCY=60

# Ogni quanti secondi il proxy invia i dati raccolti al server
ZBX_DATASENDERFREQUENCY=1

# ==============================================================================
# Buffer dati (7.0+)
# ==============================================================================

# disk | memory | hybrid - hybrid tiene i dati in RAM e scrive su SQLite solo
# se il server e' irraggiungibile o il buffer si riempie (meno usura disco)
ZBX_PROXYBUFFERMODE=hybrid

# Dimensione del buffer in memoria (usato solo con memory/hybrid)
ZBX_PROXYMEMORYBUFFERSIZE=128M

# Eta' massima (secondi) dei dati in RAM prima del flush su disco
ZBX_PROXYMEMORYBUFFERAGE=600

# Ore di dati bufferizzati se il server centrale e' offline
ZBX_PROXYOFFLINEBUFFER=24

# Ore di dati mantenuti localmente anche dopo l'invio (0 = cancella subito).
# ATTENZIONE: deve restare 0 con ProxyBufferMode memory/hybrid, altrimenti il
# proxy rifiuta di avviarsi. Serve solo se un'applicazione terza legge il
# database SQLite del proxy: in quel caso metti ZBX_PROXYBUFFERMODE=disk.
ZBX_PROXYLOCALBUFFER=0

# ==============================================================================
# Cache
# ==============================================================================

# Cache di configurazione (host, item, trigger scaricati dal server)
ZBX_CACHESIZE=64M

# Cache dei dati storici in attesa di invio al server
ZBX_HISTORYCACHESIZE=32M

# Indice della history cache
ZBX_HISTORYINDEXCACHESIZE=16M

# Frequenza (ore) della pulizia del database locale
ZBX_HOUSEKEEPINGFREQUENCY=1

# ==============================================================================
# Pollers sincroni
# ==============================================================================

# Poller per check classici (SNMP v3, IPMI, JMX, script)
ZBX_STARTPOLLERS=5

# Poller dedicati agli host non raggiungibili
ZBX_STARTPOLLERSUNREACHABLE=3

# Processi per ICMP ping (fping)
ZBX_STARTPINGERS=3

# Trapper: ricevono i dati dagli agent ATTIVI della sede
ZBX_STARTTRAPPERS=5

# Processi per network discovery
ZBX_STARTDISCOVERERS=3

# Processi per web monitoring (scenari HTTP)
ZBX_STARTHTTPPOLLERS=3

# Processi di preprocessing dei valori raccolti
ZBX_STARTPREPROCESSORS=3

# Processi che scrivono sul database SQLite locale
ZBX_STARTDBSYNCERS=4

# ==============================================================================
# Pollers asincroni (7.0+)
# ==============================================================================
# Gestiscono molti check in parallelo per processo: preferiscili ai pollers
# classici per agent, SNMP e HTTP agent su sedi con molti host.

# Poller asincroni per item Zabbix agent
ZBX_STARTAGENTPOLLERS=3

# Poller asincroni per item SNMP
ZBX_STARTSNMPPOLLERS=3

# Poller asincroni per item HTTP agent
ZBX_STARTHTTPAGENTPOLLERS=3

# Check concorrenti gestiti da ogni poller asincrono
ZBX_MAXCONCURRENTCHECKSPERPOLLER=1000

# ==============================================================================
# SNMP traps
# ==============================================================================

# Processi che leggono le trap ricevute dal container snmptraps
ZBX_STARTSNMPTRAPPER=1
