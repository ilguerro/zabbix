# ==============================================================================
# Zabbix Proxy Configuration - Customer Site
# ==============================================================================
# Customize this file for EACH customer site, then copy it to .env
# Reference sizing: small/medium site (2 vCPU, 4GB RAM, ~200 hosts)

# Docker image tag to deploy. MUST match the central server's Zabbix
# version (same major.minor) or proxy<->server communication breaks.
# Applied on the next "docker compose up -d".
#ZABBIX_VERSION=alpine-7.4.14
ZABBIX_VERSION=alpine-trunk # 8.0

# Timezone for all containers (log timestamps).
TZ=Europe/Rome

# ==============================================================================
# Identification and connection to the central server
# ==============================================================================

# Proxy name registered in the frontend under Administration -> Proxies.
# Must match EXACTLY (case-sensitive) or the central server rejects this
# proxy's connections.
ZBX_PROXY_HOSTNAME=proxy-acme

# Address the proxy connects to for config and data upload (active mode).
# Add the port explicitly if non-standard: zabbix.acme.tld:10051
ZBX_SERVER_HOST=zabbix.acme.tld

# 0 = active: the proxy initiates every connection to the server - works
#     behind NAT/firewall, no inbound ports opened at the site.
# 1 = passive: the server connects to the proxy instead.
ZBX_PROXYMODE=0

# Interface the proxy's ports (10051/tcp trapper, 162/udp SNMP traps) are
# exposed on. 0.0.0.0 = every interface; set the site's LAN IP to avoid
# exposing them anywhere else.
ZBX_LISTEN_ADDR=0.0.0.0

# ==============================================================================
# TLS PSK towards the central server
# ==============================================================================

# Label for the pre-shared key, entered together with the value in the
# frontend's proxy settings. Must match exactly.
ZBX_TLS_PSK_IDENTITY=PSK-acme

# Pre-shared key encrypting all proxy<->server traffic, 64 hex chars.
# Generate with: openssl rand -hex 32
# Must match the frontend value exactly, and be UNIQUE per site: sharing
# one PSK between proxies would let them impersonate each other.
ZBX_TLS_PSK_VALUE=psk # Generate using `openssl rand -hex 32`

# ==============================================================================
# Synchronization with the server
# ==============================================================================

# Seconds to wait for the site's devices (agent/SNMP/external checks)
# before giving up. Higher tolerates slow/remote gear but each slow check
# occupies its poller longer, delaying the collection queue.
ZBX_TIMEOUT=30

# How often (seconds) the proxy re-downloads its configuration from the
# server (ProxyConfigFrequency since 7.0). Lower = changes made in the
# frontend reach this site sooner, at the cost of more frequent requests
# against the central server.
ZBX_PROXYCONFIGFREQUENCY=60

# How often (seconds) collected data is batched and uploaded to the
# server. Lower = fresher data in the frontend but more frequent, smaller
# transfers; higher = better batching with more latency.
ZBX_DATASENDERFREQUENCY=1

# ==============================================================================
# Data buffer (Zabbix 7.0+)
# ==============================================================================

# Where collected values live until sent to the server:
#   disk   - always written to local SQLite: survives power loss, costs
#            constant disk writes.
#   memory - RAM only: fastest, but all unsent data is LOST on crash or
#            restart.
#   hybrid - kept in RAM and offloaded to SQLite only while the server is
#            unreachable or RAM is full: best trade-off (and easiest on
#            SSDs / SD cards).
ZBX_PROXYBUFFERMODE=hybrid

# Size of the RAM buffer (memory/hybrid modes). Larger = more data rides
# out a server outage before anything needs the disk.
ZBX_PROXYMEMORYBUFFERSIZE=128M

# In hybrid mode, values older than this many seconds are offloaded from
# RAM to SQLite even when the server is reachable. Lower frees RAM sooner
# but writes to disk more; higher keeps more in RAM.
ZBX_PROXYMEMORYBUFFERAGE=600

# Hours of data to keep while the central server is unreachable. Once
# exceeded, the OLDEST values are discarded to make room - raise it (and
# the buffer sizes) to ride out longer outages.
ZBX_PROXYOFFLINEBUFFER=24

# Hours of data to keep locally even AFTER successful delivery
# (0 = delete as soon as the server confirms). WARNING: must stay 0 with
# buffer mode memory/hybrid or the proxy refuses to start. Only raise it
# (together with ZBX_PROXYBUFFERMODE=disk) if a third-party application
# needs to read the proxy's SQLite database.
ZBX_PROXYLOCALBUFFER=0

# ==============================================================================
# Caches
# ==============================================================================

# Cache of the configuration downloaded from the server (this site's
# hosts/items). Must fit the whole config or the proxy fails to start;
# extra beyond that is unused RAM.
ZBX_CACHESIZE=64M

# Queue of collected values waiting to be sent to the server. If it fills
# completely, collection stalls until the server drains it.
ZBX_HISTORYCACHESIZE=32M

# Index of the history cache - scales with item count, not data volume.
ZBX_HISTORYINDEXCACHESIZE=16M

# How often (hours) the proxy purges already-sent data from its local
# SQLite. 0 disables housekeeping entirely - the database then grows
# without bounds; more frequent = steadier, smaller cleanups.
ZBX_HOUSEKEEPINGFREQUENCY=1

# ==============================================================================
# Synchronous pollers
# ==============================================================================
# Each process runs one check at a time. Raise a count when the site's
# queue grows or that poller type shows high utilization in the frontend;
# extra processes idle in RAM and add CPU context switching.

# Pollers for classic checks (SNMP v3, IPMI, JMX, script, ssh/telnet).
ZBX_STARTPOLLERS=5

# Pollers reserved for unreachable hosts so their retries don't steal
# capacity from healthy hosts.
ZBX_STARTPOLLERSUNREACHABLE=3

# ICMP ping workers (fping); each handles many hosts per round.
ZBX_STARTPINGERS=3

# Trappers accepting pushed data from the site's ACTIVE agents and
# zabbix_sender. More = absorbs more devices reporting at once.
ZBX_STARTTRAPPERS=5

# Workers for network discovery rules - one per rule being scanned.
ZBX_STARTDISCOVERERS=3

# Workers for web monitoring scenarios (HTTP steps).
ZBX_STARTHTTPPOLLERS=3

# Workers preprocessing collected values (multipliers, regex, throttling,
# dependent items) before they are buffered.
ZBX_STARTPREPROCESSORS=3

# Writers flushing collected values into the local SQLite database
# (active in disk/hybrid mode). Too few = writes back up while the server
# is unreachable.
ZBX_STARTDBSYNCERS=4

# ==============================================================================
# Asynchronous pollers (Zabbix 7.0+)
# ==============================================================================
# Each async poller juggles many checks concurrently in a single process -
# far more efficient than the synchronous pollers above. Prefer these for
# agent, SNMP and HTTP agent items; keep sync pollers for IPMI/JMX/script.

# Async pollers for Zabbix agent items.
ZBX_STARTAGENTPOLLERS=3

# Async pollers for SNMP items.
ZBX_STARTSNMPPOLLERS=3

# Async pollers for HTTP agent items.
ZBX_STARTHTTPAGENTPOLLERS=3

# Concurrent checks each async poller may juggle at once. Raise it if
# checks queue up inside a busy poller; every concurrent check costs a
# file descriptor (the compose file already raises the limit to 16384) so
# don't push it past that.
ZBX_MAXCONCURRENTCHECKSPERPOLLER=1000

# ==============================================================================
# SNMP traps
# ==============================================================================

# Trapper processes reading the trap file written by the snmptraps
# container. 1 enables SNMP trap processing; 0 disables it (traps received
# by the container would then go unprocessed).
ZBX_STARTSNMPTRAPPER=1
